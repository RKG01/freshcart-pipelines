# Copy to .env locally and fill only the values required for your account.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FRESHCART
RABBITMQ_USER=your_local_rabbitmq_user
RABBITMQ_PASSWORD=replace_with_a_secure_random_password
RABBITMQ_URL=amqp://USERNAME:PASSWORD@localhost:5672/%2F
